{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "semi": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn"
  },
  "globals": {
    "URL": "readonly",
    "FileReader": "readonly",
    "navigator": "readonly",
    "document": "readonly",
    "window": "readonly"
  }
}
