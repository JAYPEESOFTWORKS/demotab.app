# Cloudflare Pages — HTTP Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ── App (main tab) — IRON STRICT ─────────────────────────────
# connect-src 'none' means the browser CANNOT make any network
# request from this page. Not us, not anyone. Verifiable in DevTools.
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'none'; frame-src 'blob:' 'self'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Also apply to root path (Cloudflare Pages serves index.html for /)
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'none'; frame-src 'blob:' 'self'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# App assets — same strict policy
/app.js
  Content-Security-Policy: default-src 'none'
  Cache-Control: public, max-age=31536000, immutable

/app.css
  Content-Security-Policy: default-src 'none'
  Cache-Control: public, max-age=31536000, immutable

# ── About page — same strict policy (no analytics) ───────────
/about.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# ── Catch-all ────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
